---
import '@fontsource-variable/sora';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import Mark from '../components/Mark.astro';

interface Props {
  title?: string;
  description?: string;
  product?: string; // product id, shows "obiba / <product>" in the header
}
const { title, description = 'Open source software for epidemiology', product } = Astro.props;
const fullTitle = title ? `${title} · OBiBa` : 'OBiBa · Open Source Software for Epidemiology';

const nav = [
  ['/#products', 'Products'],
  ['/news/', 'News'],
  ['/download/', 'Download'],
  ['/support/', 'Support'],
  ['/about/', 'About'],
];
const footerNav = [
  ['/stories/', 'User stories'],
  ['/publications/', 'Publications'],
  ['/presentations/', 'Presentations'],
  ['/infra/', 'Infrastructure'],
  ['/pkg/', 'Debian packages'],
  ['/rpm/', 'RPM packages'],
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00615C" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/img/obiba-favicon.png" sizes="32x32" />
    <link rel="alternate" type="application/rss+xml" title="OBiBa news" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href="/" class="brand" aria-label="OBiBa home">
          <Mark product={product} size={30} />
          <span class="brand-name">obiba</span>
          {product && <><span class="brand-sep">/</span><span class="brand-product">{product}</span></>}
        </a>
        <nav aria-label="Main">
          {nav.map(([href, label]) => (
            <a href={href} aria-current={path.startsWith(href) && href !== '/#products' ? 'page' : undefined}>{label}</a>
          ))}
          <a href="https://github.com/obiba" class="gh">GitHub</a>
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-inner">
        <a href="/" class="brand brand-sm" aria-label="OBiBa home"><Mark size={22} /><span class="brand-name">obiba</span></a>
        <nav aria-label="Footer">
          {footerNav.map(([href, label]) => <a href={href}>{label}</a>)}
        </nav>
        <p>© {new Date().getFullYear()} OBiBa · Open source under the <a href="/about/#license">GPL v3</a> · <a href="/rss.xml">RSS</a> · <a href="https://github.com/obiba">GitHub</a></p>
      </div>
    </footer>
  </body>
</html>
